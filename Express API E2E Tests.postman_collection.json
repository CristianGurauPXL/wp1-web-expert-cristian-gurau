    {
      "name": "/pets?_embed=persons",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Pets contain embedded persons\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "\r",
              "    const pets = pm.response.json();\r",
              "\r",
              "    pm.expect(pets).to.be.an(\"array\");\r",
              "    pm.expect(pets.length).to.be.greaterThan(0);\r",
              "\r",
              "    for (const pet of pets) {\r",
              "        pm.expect(pet).to.have.property(\"ownerIds\");\r",
              "        pm.expect(pet.ownerIds).to.be.an(\"array\");\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
