    {
      "name": "/persons",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Person was created successfully\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "\r",
              "    const person = pm.response.json();\r",
              "\r",
              "    pm.expect(person.id).to.be.a(\"string\");\r",
              "    pm.expect(person.id).to.match(\r",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i\r",
              "    );\r",
              "\r",
              "    pm.expect(person.name).to.equal(\"Postman Test Person\");\r",
              "\r",
              "    pm.collectionVariables.set(\"personId\", person.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
